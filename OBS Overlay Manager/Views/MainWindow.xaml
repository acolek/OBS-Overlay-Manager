<Window x:Class="OBS_Overlay_Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OBS_Overlay_Manager"
        mc:Ignorable="d"
        Title="OBS Overlay Manager" Height="350" Width="800" MinHeight="300" MinWidth="500"
        Closing="On_Close">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Grid.Column="0" Header="Left Overlay" Padding="5" Margin="5">
            <Grid Grid.Row="1" Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label    Grid.Row="0" Grid.Column="0">Color:</Label>
                <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Name="cmbColorLeft" SelectedIndex="{Binding ColorLeft, Mode=TwoWay}">
                    <ComboBoxItem>Blue</ComboBoxItem>
                    <ComboBoxItem>Gold</ComboBoxItem>
                    <ComboBoxItem>Green</ComboBoxItem>
                    <ComboBoxItem>Purple</ComboBoxItem>
                    <ComboBoxItem>Red</ComboBoxItem>
                </ComboBox>

                <Label   Grid.Row="2" Grid.Column="0">Team Name:</Label>
                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Name="txtTeamNameLeft" Text="{Binding TeamNameLeft}"/>

                <Label VerticalAlignment="Center" Grid.Row="4" Grid.Column="0">Score:</Label>
                <Button  Name="btnDecLeft"       Grid.Row="4" Grid.Column="1" FontSize="24" Command="{Binding CmdDecrementScoreLeft}" Padding="0 0 0 4">-</Button>
                <TextBox Name="txtScoreLeft"     Grid.Row="4" Grid.Column="2" FontSize="24" Text="{Binding ScoreLeft}" HorizontalContentAlignment="Center"/>
                <Button  Name="btnIncLeft"       Grid.Row="4" Grid.Column="3" FontSize="24" Command="{Binding CmdIncrementScoreLeft}" Padding="0 0 0 4">+</Button>

                <Label    Grid.Row="6" Grid.Column="0">Profile:</Label>
                <ComboBox Grid.Row="6" Grid.Column="1" Name="cmbProfileLeft" Text="{Binding ProfileNameLeft}" ItemsSource="{Binding Path=AllProfiles}"
                          DisplayMemberPath="ProfileName" SelectedIndex="{Binding ProfileIndexLeft}" Grid.ColumnSpan="2" IsEditable="True"/>
                <Button   Grid.Row="6" Grid.Column="3" Name="btnSaveProfileLeft"   Command="{Binding CmdSaveProfileLeft}"   Margin="5 0 0 0">Save</Button>
                <Button   Grid.Row="6" Grid.Column="4" Name="btnDeleteProfileLeft" Command="{Binding CmdDeleteProfileLeft}" Margin="5 0 0 0">Delete</Button>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="0" Grid.Column="1" Header="Right Overlay" Padding="5" Margin="5">
            <Grid Grid.Row="1" Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label    Grid.Row="0" Grid.Column="0">Color:</Label>
                <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Name="cmbColorRight" SelectedIndex="{Binding ColorRight, Mode=TwoWay}">
                    <ComboBoxItem>Blue</ComboBoxItem>
                    <ComboBoxItem>Gold</ComboBoxItem>
                    <ComboBoxItem>Green</ComboBoxItem>
                    <ComboBoxItem>Purple</ComboBoxItem>
                    <ComboBoxItem>Red</ComboBoxItem>
                </ComboBox>

                <Label   Grid.Row="2" Grid.Column="0">Team Name:</Label>
                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Name="txtTeamNameRight" Text="{Binding TeamNameRight}"/>

                <Label VerticalAlignment="Center" Grid.Row="4" Grid.Column="0">Score:</Label>
                <Button  Name="btnDecRight"       Grid.Row="4" Grid.Column="1" FontSize="24" Command="{Binding CmdDecrementScoreRight}" Padding="0 0 0 4">-</Button>
                <TextBox Name="txtScoreRight"     Grid.Row="4" Grid.Column="2" FontSize="24" Text="{Binding ScoreRight}" HorizontalContentAlignment="Center"/>
                <Button  Name="btnIncRight"       Grid.Row="4" Grid.Column="3" FontSize="24" Command="{Binding CmdIncrementScoreRight}" Padding="0 0 0 4">+</Button>

                <Label    Grid.Row="6" Grid.Column="0">Profile:</Label>
                <ComboBox Grid.Row="6" Grid.Column="1" Name="cmbProfileRight" Text="{Binding ProfileNameRight}" ItemsSource="{Binding Path=AllProfiles}"
                          DisplayMemberPath="ProfileName" SelectedIndex="{Binding ProfileIndexRight}" Grid.ColumnSpan="2" IsEditable="True"/>
                <Button   Grid.Row="6" Grid.Column="3" Name="btnSaveProfileRight"   Command="{Binding CmdSaveProfileRight}"   Margin="5 0 0 0">Save</Button>
                <Button   Grid.Row="6" Grid.Column="4" Name="btnDeleteProfileRight" Command="{Binding CmdDeleteProfileRight}" Margin="5 0 0 0">Delete</Button>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="1" Grid.ColumnSpan="2" Header="Controls" Padding="5" Margin="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Button   Grid.Column="0" Name="btnResetScores" Padding="5" Command="{Binding CmdResetScores}">Reset Scores</Button>
                <Button   Grid.Column="2" Name="btnClearAll"    Padding="5" Command="{Binding CmdClearAll}">Clear All</Button>
                <CheckBox Grid.Column="4" Name="chkShowHide" VerticalContentAlignment="Center" IsChecked="{Binding ShowOverlays}">Show Overlays</CheckBox>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
